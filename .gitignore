.venv/
__pycache__/
*.pyc
.pytest_cache/
run/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Each subject's node workspace. The lockfile is committed, the install isn't.
subjects/*/workspace/node_modules/
subjects/*/workspace/runs/
subjects/*/workspace/test-results/
subjects/*/workspace/playwright-report/

# The reading site orbis.site builds. It gets rebuilt from subjects/ on demand.
build/
